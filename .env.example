# Copy to .env and fill in. Never commit real values.
# Alternatively store the key in macOS Keychain:
#   security add-generic-password -s applypilot -a OPENAI_API_KEY -w
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
APPLYPILOT_DATA_DIR=./data
APPLYPILOT_USE_LLM=true
APPLYPILOT_MAX_POSTING_AGE_HOURS=24
